{
  "name": "@video-studio/server",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=./.env --import tsx --watch ./src/index.ts",
    "migrate": "node --env-file-if-exists=./.env --import tsx ./src/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.9",
    "@tursodatabase/database": "^0.8.4",
    "@video-studio/types": "workspace:^",
    "drizzle-orm": "1.0.0-rc.6",
    "fastify": "^5.12.8",
    "pino-pretty": "^13.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^25.9.9",
    "drizzle-kit": "1.0.0-rc.6",
    "tsx": "^4.23.15"
  }
}
