{
  "name": "video-studio",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "type": "module",
  "private": true,
  "workspaces": [
    "./packages/*"
  ],
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.13.1",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "^12",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present dev",
    "dev:client": "pnpm --filter @video-studio/client dev",
    "dev:server": "pnpm --filter @video-studio/server dev",
    "dev:stop": "sh -c 'for port in 3000 5173; do pid=$(lsof -ti tcp:$port); [ -z \"$pid\" ] || kill $pid; done'",
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "lint": "pnpm oxlint .",
    "lint:fix": "pnpm oxlint . --fix",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "oxlint": "^1.94.0",
    "typescript-eslint": "^8.73.0"
  },
  "dependencies": {
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "typescript": "^5.9.3"
  }
}
